<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.19.7</Version>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">D:/SteamLibrary/steamapps/common/Cities Skylines II/Cities2_Data/Managed</GameManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameManagedPath)/Game.dll" Private="false" />
    <Reference Include="$(GameManagedPath)/Colossal.*.dll" Private="false" />
    <Reference Include="$(GameManagedPath)/Unity.*.dll" Private="false" />
    <Reference Include="$(GameManagedPath)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameManagedPath)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="System.Net.Http" />
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="backups/**/*.cs" />
    <None Update="UI/CityStreetOverlay.mjs" CopyToOutputDirectory="PreserveNewest" TargetPath="CityStreetOverlay.mjs" />
    <None Update="UI/CityStreetOverlay.css" CopyToOutputDirectory="PreserveNewest" TargetPath="CityStreetOverlay.css" />
  </ItemGroup>
</Project>
